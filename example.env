# Copy this file to .env (same folder) and fill in the three lines below.
# Never share or commit your .env file: it holds your key.

# openai or anthropic
PROVIDER=anthropic

# Your API key. Billed separately from a ChatGPT or Claude subscription.
API_KEY=sk-ant-your-key-here

# Model name. Check your provider's current model list before class.
# Examples: gpt-5-mini (OpenAI), claude-sonnet-5-5 (Anthropic)
MODEL=claude-sonnet-5-5
